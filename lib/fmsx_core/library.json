{
  "name": "fmsx_core",
  "version": "1.0.0",
  "description": "Vendored fMSX/EMULib core plus the ESPlay video layer. The Z80 lives in ../z80, shared with the other machine. See ../../third_party_licenses/ for the license of each piece.",
  "build": {
    "srcDir": ".",
    "srcFilter": [
      "+<fMSX/MSX.c>",
      "+<fMSX/V9938.c>",
      "+<fMSX/I8251.c>",
      "+<fMSX/Patch.c>",
      "+<EMULib/AY8910.c>",
      "+<EMULib/SCC.c>",
      "+<EMULib/YM2413.c>",
      "+<EMULib/I8255.c>",
      "+<EMULib/WD1793.c>",
      "+<EMULib/FDIDisk.c>",
      "+<EMULib/Floppy.c>",
      "+<EMULib/Hunt.c>",
      "+<EMULib/IPS.c>",
      "+<EMULib/MCF.c>",
      "+<EMULib/SHA1.c>",
      "+<EMULib/Sound.c>",
      "+<video/video_glue.c>"
    ],
    "includeDir": ".",
    "flags": ["-I ../z80", "-I fMSX", "-I EMULib", "-I video"]
  }
}
